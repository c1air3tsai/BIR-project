    "idf": "w = log10(N / df) if tf > 0, else 0",
    "tfidf": "w = tf × log10(N / df)",
    "logtfidf": "w = (1 + log10(tf)) × log10(N / df)",
    "bm25": "w = idf_BM25 × tf·(k1+1) / (tf + k1·(1 − b + b·|d|/avgdl))"
  }
